# ── Supabase (required for cloud storage + shared bookings) ─────────────────
# Dashboard → Project Settings → API
#   Project URL  → VITE_SUPABASE_URL
#   Publishable key (sb_publishable_...) OR legacy anon key (eyJ...) → VITE_SUPABASE_ANON_KEY
#
# After creating a project, run supabase/enable.sql in SQL Editor once.
# Or: set SUPABASE_DB_PASSWORD below and run `npm run supabase:setup`
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# SUPABASE_DB_PASSWORD=   # optional — for npm run supabase:setup only

# ── Admin panel (/admin) ────────────────────────────────────────────────────
VITE_ADMIN_PASSWORD=
VITE_ADMIN_USER_EMAIL=

# ── WhatsApp (E.164 without +) ──────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=
